<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="daadit_barcode_rs38.Main" t-inherit="stock_barcode.MainComponent" t-inherit-mode="extension">
        <xpath expr="//header" position="inside">
            <section t-if="resModel === 'stock.quant' and state.view === 'barcodeLines'" class="border-top p-2 bg-light text-dark">
                <button type="button" class="btn btn-outline-primary" t-on-click="rs38Toggle" t-att-disabled="rs38.busy">
                    <t t-if="rs38.enabled">RFID pauzeren</t><t t-else="">RS38 RFID scannen</t>
                </button>
                <t t-if="rs38.enabled">
                    <p class="small my-2">Selecteer eerst de juiste locatie. Scan SGTIN-96-tags en klik op Verwerk. Pas daarna de Odoo-telling toe.</p>
                    <label class="form-label small" for="daadit_rs38_input">RFID-scannerinvoer</label>
                    <textarea id="daadit_rs38_input" t-ref="rs38Input" class="form-control font-monospace" rows="1" autocomplete="off" autocapitalize="off" spellcheck="false" inputmode="text" placeholder="Tik hier en druk op de scannerknop" t-on-input.stop="rs38OnInput" t-on-keydown="rs38OnKeydown" t-att-disabled="rs38.busy"/>
                    <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                        <button type="button" class="btn btn-primary" t-on-click="rs38Process" t-att-disabled="rs38.busy">Verwerk EPC's</button>
                        <button type="button" class="btn btn-secondary" t-on-click="rs38Focus" t-att-disabled="rs38.busy">Scanner activeren</button>
                        <button type="button" class="btn btn-outline-secondary" t-on-click="rs38Discard" t-att-disabled="rs38.busy">Wis wachtende scans</button>
                        <span class="small" role="status" aria-live="polite">
                            Uniek: <t t-esc="rs38.summary.unique"/> · Verwerkt: <t t-esc="rs38.summary.accepted"/> · Wachtend: <t t-esc="rs38.summary.pending"/> · Dubbel: <t t-esc="rs38.summary.duplicates"/> · Niet verwerkt: <t t-esc="rs38.summary.failed + rs38.summary.rejected"/>
                        </span>
                    </div>
                    <details t-if="rs38.errors.length" class="text-danger small mt-2">
                        <summary>Scanproblemen (maximaal 10 getoond)</summary>
                        <ul><li t-foreach="rs38.errors" t-as="error" t-key="error_index"><t t-esc="error"/></li></ul>
                    </details>
                </t>
            </section>
        </xpath>
    </t>
</templates>
